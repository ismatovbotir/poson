# Root .htaccess for shared hosting where the domain points at the project folder

# (not at /public). Local development (php artisan serve) does not use this file.

# ---- Routing: send everything to /public -------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block hidden files and folders (.env, .git, ...).
    # /.well-known stays open for SSL certificate renewal.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>

# ---- Compression -------------------------------------------------------------

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml image/x-icon
    AddOutputFilterByType DEFLATE font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# ---- MIME types ---------------------------------------------------------------

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# ---- Browser caching (HTML pages are left to Laravel: no-cache) -------------

<IfModule mod_headers.c>
    # CSS/JS from `npm run build` (hashed names like app-mlLBE6tj.css): 1 year
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images and fonts: 7 days
    <FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # Web app manifest: 1 day
    <FilesMatch "\.webmanifest$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"

</IfModule>
