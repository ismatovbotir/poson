APP_NAME=Poson
APP_ENV=local
APP_KEY=
# Old APP_KEYs (comma-separated) still accepted for decryption after a key rotation.
# Rotate: move the old key here, set a new APP_KEY, deploy, run `php artisan secrets:reencrypt`
# (re-encrypts Settings → Integrations secrets), then remove the old key from this list.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite for dev, MySQL 8 in production; keep migrations and queries MySQL-compatible.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=poson
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Above the AI job runtime (2 × AI_TIMEOUT + 15 s), see the AI section below.
DB_QUEUE_RETRY_AFTER=150

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public site: "Add to cart" stays off until the cart exists (products use the quote CTA).
SITE_CART_ENABLED=false

# No longer used (the home page reads the catalog); kept so old .env files stay valid.
SITE_DEMO_CONTENT=false

# Reverse proxy / load balancer IPs or CIDRs, comma-separated (e.g. 10.0.0.1,10.0.1.0/24).
# Empty = trust no proxy. Never use "*": clients could spoof their IP.
TRUSTED_PROXIES=

# Local only: admin login accepts any email/password (ignored unless APP_ENV=local).
ADMIN_DEV_LOGIN=false

# Render GA4 / Yandex Metrika (Settings → Company → Tracking) outside production, e.g. on staging.
# Tracking must still be enabled in admin; logged-in staff are never tracked.
ANALYTICS_FORCE=false

# --- Integrations (plan 04b) ---------------------------------------------------
# All of these can be set by an Admin in Settings → Integrations (secrets are
# stored encrypted with APP_KEY). Leave them EMPTY to use the admin values.
# A non-empty value here wins and locks the field in admin. Never commit real values.

# AI assist: API keys (Anthropic for text/vision, OpenRouter as an alternative text provider,
# OpenAI for images, remove.bg for photo backgrounds).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
REMOVEBG_API_KEY=
# AI switches and models (models must be in config/ai-assist.php), per-user daily limits,
# monthly budget in whole USD (AI turns off when reached).
AI_ENABLED=
# Text provider: anthropic (default) or openrouter. The OpenRouter model is a
# provider/model ID (e.g. nvidia/nemotron-3.5-super-vl:free); set
# AI_OPENROUTER_ALLOW_DATA_COLLECTION=false to use only providers that don't log prompts.
AI_TEXT_PROVIDER=
AI_OPENROUTER_MODEL=
AI_OPENROUTER_ALLOW_DATA_COLLECTION=
AI_TEXT_MODEL=
AI_VISION_MODEL=
AI_IMAGE_MODEL=
AI_DAILY_LIMIT_PER_USER=
AI_DAILY_IMAGE_LIMIT_PER_USER=
AI_MONTHLY_BUDGET_USD=
# AI text requests run on the "ai" queue: php artisan queue:work --queue=ai,default
# Provider request timeouts in seconds (defaults 45 and 120; not editable in admin).
# The AI job may run 2 × AI_TIMEOUT + 15 s (105 s at 45): the queue's retry_after
# (DB_QUEUE_RETRY_AFTER / REDIS_QUEUE_RETRY_AFTER, default 90) must be larger, e.g. 150.
AI_TIMEOUT=
AI_IMAGE_TIMEOUT=

# Telegram bot token (from @BotFather), webhook secret (generate it in admin) and chat IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SALES_CHAT_ID=
TELEGRAM_SERVICE_CHAT_ID=
TELEGRAM_FINANCE_CHAT_ID=
# New-lead alerts on/off (default true) and the language of Telegram messages: uz (default), ru or en.
TELEGRAM_NOTIFY_NEW_LEADS=
# Finance-chat alert when a price API batch has unknown / invalid codes or is rejected (default true).
TELEGRAM_NOTIFY_PRICE_SYNC=
TELEGRAM_LOCALE=

# Payme merchant: cabinet ID, live key, sandbox key, mode "test" or "prod".
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
PAYME_MODE=

# Click SHOP API: IDs from the merchant cabinet and the secret key.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# First-party traffic analytics (admin → Analytics, AI visibility). Recording on/off (default on);
# growth guard per day: visitor rows (default 200000) and crawler rows (default 150000);
# cache store for the daily visitor salt (default: CACHE_STORE; use redis in production).
ANALYTICS_TRACKING=
ANALYTICS_MAX_VISITS_PER_DAY=
ANALYTICS_MAX_BOT_HITS_PER_DAY=
ANALYTICS_SALT_STORE=
