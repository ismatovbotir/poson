APP_NAME=Poson
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite for dev, MySQL 8 in production; keep migrations and queries MySQL-compatible.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=poson
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public site: "Add to cart" stays off until the cart exists (products use the quote CTA).
SITE_CART_ENABLED=false

# No longer used (the home page reads the catalog); kept so old .env files stay valid.
SITE_DEMO_CONTENT=false

# Reverse proxy / load balancer IPs or CIDRs, comma-separated (e.g. 10.0.0.1,10.0.1.0/24).
# Empty = trust no proxy. Never use "*": clients could spoof their IP.
TRUSTED_PROXIES=

# Local only: admin login accepts any email/password (ignored unless APP_ENV=local).
ADMIN_DEV_LOGIN=false

# Render GA4 / Yandex Metrika (Settings → Company → Tracking) outside production, e.g. on staging.
# Tracking must still be enabled in admin; logged-in staff are never tracked.
ANALYTICS_FORCE=false
