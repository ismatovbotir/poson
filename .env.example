APP_NAME=Poson
APP_ENV=local
APP_KEY=
# Old APP_KEYs (comma-separated) still accepted for decryption after a key rotation.
# Rotate: move the old key here, set a new APP_KEY, deploy, run `php artisan secrets:reencrypt`
# (re-encrypts Settings → Integrations secrets), then remove the old key from this list.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite for dev, MySQL 8 in production; keep migrations and queries MySQL-compatible.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=poson
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public site: "Add to cart" stays off until the cart exists (products use the quote CTA).
SITE_CART_ENABLED=false

# No longer used (the home page reads the catalog); kept so old .env files stay valid.
SITE_DEMO_CONTENT=false

# Reverse proxy / load balancer IPs or CIDRs, comma-separated (e.g. 10.0.0.1,10.0.1.0/24).
# Empty = trust no proxy. Never use "*": clients could spoof their IP.
TRUSTED_PROXIES=

# Local only: admin login accepts any email/password (ignored unless APP_ENV=local).
ADMIN_DEV_LOGIN=false

# First Admin account, created once by `php artisan db:seed --class=LaunchSeeder --force`
# (password at least 12 characters; an existing email is left unchanged).
# Remove both after the first seed, then run `php artisan config:clear && php artisan config:cache`.
ADMIN_SEED_LOGIN=
ADMIN_SEED_PASSWORD=

# Render GA4 / Yandex Metrika (Settings → Company → Tracking) outside production, e.g. on staging.
# Tracking must still be enabled in admin; logged-in staff are never tracked.
ANALYTICS_FORCE=false

# --- Integrations (plan 04b) ---------------------------------------------------
# All of these can be set by an Admin in Settings → Integrations (secrets are
# stored encrypted with APP_KEY). Leave them EMPTY to use the admin values.
# A non-empty value here wins and locks the field in admin. Never commit real values.

# Telegram bot token (from @BotFather), webhook secret (generate it in admin) and chat IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SALES_CHAT_ID=
TELEGRAM_SERVICE_CHAT_ID=
TELEGRAM_FINANCE_CHAT_ID=
# New-lead alerts on/off (default true) and the language of Telegram messages: uz (default), ru or en.
TELEGRAM_NOTIFY_NEW_LEADS=
# Finance-chat alert when a price API batch has unknown / invalid codes or is rejected (default true).
TELEGRAM_NOTIFY_PRICE_SYNC=
TELEGRAM_LOCALE=

# Payme merchant: cabinet ID, live key, sandbox key, mode "test" or "prod".
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
PAYME_MODE=

# Click SHOP API: IDs from the merchant cabinet and the secret key.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Click test service (sandbox) and the active mode "test" (default) or "prod".
CLICK_TEST_SERVICE_ID=
CLICK_TEST_MERCHANT_USER_ID=
CLICK_TEST_SECRET_KEY=
CLICK_MODE=

# First-party traffic analytics (admin → Analytics, AI visibility). Recording on/off (default on);
# growth guard per day: visitor rows (default 200000) and crawler rows (default 150000);
# cache store for the daily visitor salt (default: CACHE_STORE; use redis in production).
ANALYTICS_TRACKING=
ANALYTICS_MAX_VISITS_PER_DAY=
ANALYTICS_MAX_BOT_HITS_PER_DAY=
ANALYTICS_SALT_STORE=
